# EXAMPLE OF '.env' (yes, the bot is configured entirely through environment variables)

# === General ===
BOT_PREFIX = "!" # lightning only
DISABLE_CALC = "false" # should work with untrusted input, but if you want to be safe you can disable it

#    Override the defaults insults/compliments/flirts/animegirl gifs:
# INSULTS = "EXAMPLE_A:EXAMPLE_B"                                    # "insult" command
# COMPLIMENTS = "EXAMPLE_A:EXAMPLE_B"                                # "compliment" command
# FLIRTS = "EXAMPLE_A:EXAMPLE_B"                                     # "flirt" command
# ANIMEGIRLS = "https://example.com/a.gif:https://example.com/b.gif" # "animegirl" command

# currently only option for confessions
CONFESSIONS_WEBHOOK_URL = "https://discord.com/api/webhooks/..."

# === Ai ===
DISABLE_AI = "false"

AI_KEY = "ollama"
AI_MODEL = "tinydolphin"
AI_BASEURL = "http://localhost:11434/v1" # openai (v1) compatible

# === Discord === (disgo only)
DISCORD_BOT_TOKEN = "PUT_DISCORD_TOKEN_HERE" # required
DISCORD_OWNER_ID = "1111111111"              # optional

# === IRC === (lightning only)

# since there are many IRC environment variables, we have a "DO_IRC" flag
DO_IRC = "true"

IRC_SERVER = "localhost:6667" # required
IRC_NICK = "monica"           # required
IRC_TLS = "false"             # optional
IRC_SASL_USER = ""            # optional
IRC_SASL_PASS = ""            # optional
IRC_COMMANDS_ONCONNECT = ""   # optional
