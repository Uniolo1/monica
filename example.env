# EXAMPLE OF '.env'
DISCORD_BOT_TOKEN = "DISCORD_TOKEN" # NOTE: currently only Discord argument

# since there are many IRC environment variables, we have a "DO_IRC" flag
DO_IRC = "true"

IRC_SERVER = "localhost:6667" # required
IRC_NICK = "monica"           # required
IRC_TLS = "false"             # optional
IRC_SASL_USER = ""            # optional
IRC_SASL_PASS = ""            # optional
IRC_COMMANDS_ONCONNECT = ""   # optional